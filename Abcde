<!DOCTYPE html>
<html lang="hi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday My Special One! ❤️✨</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        roseGold: '#B76E79',
                        softPink: '#FFF0F5',
                        deepRose: '#FF6B8B',
                        warmPeach: '#FFD1DC',
                        accentViolet: '#A29BFE'
                    },
                    fontFamily: {
                        cursive: ['Dancing Script', 'cursive'],
                        hand: ['Caveat', 'cursive'],
                        sans: ['Plus Jakarta Sans', 'sans-serif']
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Custom Animations & Effects */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(3deg); }
        }
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.8; filter: drop-shadow(0 0 15px rgba(255, 107, 139, 0.6)); }
            50% { opacity: 1; filter: drop-shadow(0 0 25px rgba(255, 107, 139, 0.9)); }
        }
        @keyframes flicker {
            0%, 100% { transform: scale(1) rotate(-2deg); opacity: 0.9; }
            25% { transform: scale(1.1) rotate(2deg); opacity: 1; }
            50% { transform: scale(0.95) rotate(-1deg); opacity: 0.8; }
            75% { transform: scale(1.05) rotate(1deg); opacity: 1; }
        }

        .animate-float { animation: float 4s ease-in-out infinite; }
        .animate-flicker { animation: flicker 0.6s ease-in-out infinite; }
        .pulse-glow { animation: pulseGlow 2s infinite; }

        /* Memory Card Flip Effect */
        .perspective-1000 { perspective: 1000px; }
        .transform-style-3d { transform-style: preserve-3d; }
        .backface-hidden { backface-visibility: hidden; }
        .rotate-y-180 { transform: rotateY(180deg); }

        /* Glassmorphism */
        .glass-card {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.8);
        }
        .glass-dark {
            background: rgba(30, 20, 35, 0.55);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        /* Cake Candle CSS */
        .flame {
            width: 16px;
            height: 26px;
            background: linear-gradient(to top, #ff9d00, #ff5100, #fff700);
            border-radius: 50% 50% 20% 20%;
            position: absolute;
            top: -26px;
            left: 50%;
            transform: translateX(-50%);
            box-shadow: 0 0 15px #ff9d00, 0 0 30px #ff5100;
            transform-origin: center bottom;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #fff0f5; }
        ::-webkit-scrollbar-thumb { background: #ff6b8b; border-radius: 10px; }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-pink-950 to-slate-900 text-slate-100 font-sans min-h-screen overflow-x-hidden relative selection:bg-pink-500 selection:text-white">

    <canvas id="bgCanvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

    <!-- Floating Audio Control Button -->
