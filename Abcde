        <button id="musicToggle" onclick="toggleMusic()" class="glass-card text-pink-600 hover:text-pink-700 p-3.5 rounded-full shadow-lg border border-pink-200/50 hover:scale-110 transition-all duration-300 flex items-center justify-center group" title="Play Music">
