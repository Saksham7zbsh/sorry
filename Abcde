    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // 1. Canvas Background Floating Hearts & Stars
        const canvas = document.getElementById('bgCanvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() {
                this.reset();
            }
            reset() {
                this.x = Math.random() * canvas.width;
                this.y = canvas.height + 20;
                this.size = Math.random() * 15 + 8;
                this.speedY = Math.random() * 1.5 + 0.5;
                this.opacity = Math.random() * 0.5 + 0.3;
                this.type = Math.random() > 0.4 ? 'heart' : 'star';
                this.color = `hsl(${Math.random() * 40 + 330}, 100%, 75%)`;
            }
            update() {
                this.y -= this.speedY;
                if (this.y < -20) this.reset();
            }
            draw() {
                ctx.save();
                ctx.globalAlpha = this.opacity;
                ctx.fillStyle = this.color;
                if (this.type === 'heart') {
                    ctx.font = `${this.size}px serif`;
                    ctx.fillText('❤️', this.x, this.y);
                } else {
                    ctx.font = `${this.size}px serif`;
                    ctx.fillText('✨', this.x, this.y);
                }
                ctx.restore();
            }
        }

        for (let i = 0; i < 35; i++) {
            particles.push(new Particle());
        }

        function animateBg() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateBg);
        }
        animateBg();

        // 2. Memory Card Flip Function
        function flipCard(card) {
            const inner = card.querySelector('.card-inner');
            inner.classList.toggle('rotate-y-180');
        }

        // 3. Gift Unwrapping Logic
        function unwrapGift(btn, message) {
            btn.classList.add('scale-90', 'opacity-50');
            const output = document.getElementById('giftOutput');
            output.innerHTML = `🎁 Surprise: "<strong>${message}</strong>"`;
            output.classList.remove('hidden');

            confetti({
                particleCount: 40,
                spread: 60,
                origin: { y: 0.7 }
            });
        }

        // 4. Cake Candle Blow Out
        let isCandleBlown = false;
        function blowCandle() {
            if (isCandleBlown) return;

            const flame = document.getElementById('flame');
            const status = document.getElementById('cakeStatus');

            flame.style.display = 'none';
            isCandleBlown = true;

            status.innerHTML = "🎉 Yay! Make a wish! Happy Birthday! 🥳✨";
            status.classList.add('text-amber-300', 'font-bold', 'text-xl');

            // Sound Effect using Tone.js
            try {
                const synth = new Tone.PolySynth().toDestination();
                const now = Tone.now();
                synth.triggerAttackRelease(["C4", "E4", "G4", "C5"], "8n", now);
                synth.triggerAttackRelease(["G4", "B4", "D5", "G5"], "8n", now + 0.2);
            } catch (e) {
                console.log('Audio synth playback blocked or unsupported');
            }

            // Big Confetti Blast
            confetti({
                particleCount: 120,
                spread: 100,
                origin: { y: 0.6 }
            });

            setTimeout(() => {
                confetti({
                    particleCount: 80,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 }
                });
                confetti({
                    particleCount: 80,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 }
                });
            }, 300);
        }

        // 5. Random Wish Generator
        const wishes = [
            "Tumhari smile poore din ko bright kar deti hai! Always keep shining ✨",
            "You deserve all the sweetness, happiness & joy in the entire universe! 🌟",
            "Aap hamesha aise hi muskurate raho aur sabki life me khushiyan bikhapte raho 💖",
            "May your year ahead be full of amazing adventures & sweet surprises! 🍦",
            "You are a rare gift to everyone who knows you! Stay wonderful! 💐",
            "Har din tumhare liye khubsoorat yaadein le kar aaye! Happy Birthday! 🎉"
        ];

        function generateWish() {
            const display = document.getElementById('wishDisplay');
            const randomWish = wishes[Math.floor(Math.random() * wishes.length)];
            
            display.style.opacity = 0;
            setTimeout(() => {
                display.innerHTML = `"${randomWish}"`;
                display.style.opacity = 1;
            }, 200);

            confetti({
                particleCount: 25,
                spread: 50,
                origin: { y: 0.8 }
            });
        }

        // 6. Background Music Synth Chime Player
        let isPlaying = false;
        let bgLoop;

        function toggleMusic() {
            const icon = document.getElementById('musicIcon');
            
            if (!isPlaying) {
                try {
                    Tone.start();
                    const synth = new Tone.Synth({
                        oscillator: { type: "sine" },
                        envelope: { attack: 0.1, decay: 0.2, sustain: 0.5, release: 1 }
                    }).toDestination();
                    synth.volume.value = -12;

                    const notes = ["C4", "E4", "G4", "B4", "C5", "G4", "E4"];
                    let index = 0;

                    bgLoop = setInterval(() => {
                        synth.triggerAttackRelease(notes[index % notes.length], "8n");
                        index++;
                    }, 400);

                    isPlaying = true;
                    icon.classList.add('text-pink-500', 'animate-spin');
                } catch(e) {
                    console.log('Audio error:', e);
                }
            } else {
                clearInterval(bgLoop);
                isPlaying = false;
                icon.classList.remove('text-pink-500', 'animate-spin');
            }
        }
    </script>
</body>
</html>
